{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "portal_role": {
      "type": "string",
      "description": "Portal access assigned by the academy office from the dashboard: admin, editor, staff, teacher, student, parent or owner. App users cannot set or change this themselves.",
      "enum": [
        "admin",
        "editor",
        "staff",
        "teacher",
        "student",
        "parent",
        "owner"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}